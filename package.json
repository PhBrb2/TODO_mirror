{
  "name": "todo-mwe",
  "private": true,
  "version": "0.79.1",
  "description": "Gamified todo app. Static web app in docs/ (GitHub Pages) wrapped as an Android app via Capacitor.",
  "type": "module",
  "scripts": {
    "cap:prepare": "node scripts/prepare-capacitor.mjs",
    "cap:add-android": "node scripts/prepare-capacitor.mjs && cap add android",
    "cap:sync": "node scripts/prepare-capacitor.mjs && cap sync android && node scripts/set-android-version.mjs",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^9.0.0-beta.0",
    "@capacitor/core": "^9.0.0-beta.0",
    "@capacitor/haptics": "^9.0.0-next.2",
    "@capacitor/local-notifications": "^9.0.0-alpha.2",
    "@todo/assistant": "file:plugins/todo-assistant"
  },
  "devDependencies": {
    "@capacitor/cli": "^9.0.0-beta.0"
  }
}
